{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clane.sh/baton/schemas/payment/v1",
  "title": "payment",
  "description": "A payment instruction accepted by the bank gateway for a matched invoice.",
  "type": "object",
  "required": [
    "payment_ref",
    "invoice_number",
    "po_number",
    "amount",
    "currency",
    "status",
    "scheduled_for"
  ],
  "properties": {
    "payment_ref": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "po_number": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "currency": {
      "type": "string"
    },
    "beneficiary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "iban": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "sent",
        "rejected"
      ]
    },
    "scheduled_for": {
      "type": "string"
    },
    "remittance_path": {
      "type": "string"
    },
    "vendor": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "description": "Workspace files this artefact is based on or produced, relative to the workspace.",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "_provenance": {
      "type": "object",
      "description": "Per field: where the value came from and how sure the producer is.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "document path or name, e.g. inbox/requisitions/PR-2026-101.pdf or masterdata/catalogue.csv"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}