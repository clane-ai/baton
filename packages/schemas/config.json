{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clane.sh/baton/schemas/config/v1",
  "title": "config",
  "description": "A configuration file or set of keys another role produced, described so the consumer can rely on it.",
  "type": "object",
  "required": ["path", "keys"],
  "properties": {
    "path": { "type": "string", "minLength": 1, "description": "Where the file lives relative to the repository or system root." },
    "format": { "type": "string", "enum": ["json", "yaml", "toml", "env", "ini", "other"] },
    "keys": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["name"], "properties": {
        "name": { "type": "string", "minLength": 1 }, "type": { "type": "string" }, "default": {}, "required": { "type": "boolean" }, "description": { "type": "string" } } }
    },
    "how_to_load": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
