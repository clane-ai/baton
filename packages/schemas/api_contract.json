{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clane.sh/baton/schemas/api_contract/v1",
  "title": "api_contract",
  "type": "object",
  "required": ["endpoints"],
  "properties": {
    "base_path": { "type": "string" },
    "version": { "type": "string" },
    "auth": { "type": "string" },
    "endpoints": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["method", "path"], "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }, "path": { "type": "string" },
        "request": { "type": "object" }, "response": { "type": "object" }, "errors": { "type": "array" }, "purpose": { "type": "string" } } }
    }
  },
  "additionalProperties": true
}
