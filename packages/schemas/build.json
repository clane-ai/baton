{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clane.sh/baton/schemas/build/v1",
  "title": "build",
  "type": "object",
  "required": ["sha", "test_command"],
  "properties": {
    "sha": { "type": "string", "minLength": 1 },
