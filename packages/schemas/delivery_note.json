{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clane.sh/baton/schemas/delivery_note/v1",
  "title": "delivery_note",
  "description": "The supplier delivery note for a purchase order: what was shipped, when, and where the document lives.",
  "type": "object",
  "required": ["delivery_note_number", "po_number", "vendor", "shipped_at", "lines"],
  "properties": {
    "delivery_note_number": { "type": "string" }, "po_number": { "type": "string" }, "vendor": { "type": "string" },
    "shipped_at": { "type": "string" }, "carrier": { "type": "string" }, "tracking": { "type": "string" },
    "lines": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["line", "item", "quantity_shipped"], "properties": {
      "line": { "type": "integer" }, "sku": { "type": "string" }, "item": { "type": "string" }, "quantity_shipped": { "type": "number", "minimum": 0 } } } },
    "document_path": { "type": "string", "description": "Where the PDF was filed, relative to the shared inbox." },
    "email_path": { "type": "string" }
  },
  "additionalProperties": true
}
