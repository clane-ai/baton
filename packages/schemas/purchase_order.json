{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clane.sh/baton/schemas/purchase_order/v1",
  "title": "purchase_order",
  "description": "A purchase order raised from a requisition: what is bought, from whom, for how much, and whether policy requires a human approval.",
  "type": "object",
  "required": [
    "po_number",
    "requisition",
    "requester",
    "vendor",
    "currency",
    "lines",
    "total",
    "cost_center",
    "delivery_address",
    "policy_check"
  ],
  "properties": {
    "po_number": {
      "type": "string",
      "pattern": "^PO-[0-9]{4}-[0-9]{3,}$"
    },
    "requisition": {
      "type": "string",
      "description": "The requisition number this PO fulfils, e.g. PR-2026-104."
    },
    "requester": {
      "type": "string"
    },
    "vendor": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "approved": {
          "type": "boolean"
        },
        "email": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "USD",
        "GBP"
      ]
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "line",
          "item",
          "quantity",
          "unit_price"
        ],
        "properties": {
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "sku": {
            "type": "string"
          },
          "item": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          },
          "line_total": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "total": {
      "type": "number",
      "minimum": 0
    },
    "cost_center": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "needed_by": {
      "type": "string"
    },
    "policy_check": {
      "type": "object",
      "required": [
        "approval_required",
        "notes"
      ],
      "properties": {
        "approval_required": {
          "type": "boolean"
        },
        "approver_level": {
          "type": "string",
          "enum": [
            "none",
            "manager",
            "director",
            "cfo"
          ]
        },
        "vendor_approved": {
          "type": "boolean"
        },
        "within_budget": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "description": "Workspace files this artefact is based on or produced, relative to the workspace.",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "_provenance": {
      "type": "object",
      "description": "Per field: where the value came from and how sure the producer is.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "document path or name, e.g. inbox/requisitions/PR-2026-101.pdf or masterdata/catalogue.csv"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}