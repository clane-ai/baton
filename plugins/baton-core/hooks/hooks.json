{
  "description": "The Baton gates (prd.md 13.4). Every hook is a command hook through the CLI shipped inside this plugin, which reads the agent token from BATON_TOKEN or ~/.baton/config.json (set by the supervisor daemon, or by `baton agents add --store`). Command hooks are used because Claude Code does not support HTTP hooks for SessionStart and does not substitute user config into HTTP hook headers, and because the lease gate must fail closed when the server is unreachable.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" gate pretool", "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" hook session-start", "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" hook prompt", "timeout": 15 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__plugin_baton-core_baton__.*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" hook tool", "timeout": 15 }]
      }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" hook tool-failure", "timeout": 15 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" hook turn-end", "timeout": 15 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/bin/baton.mjs\" hook session-end", "timeout": 15 }] }
    ]
  }
}
