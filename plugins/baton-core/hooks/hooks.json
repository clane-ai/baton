{
  "description": "The Baton gates (prd.md 13.4). PreToolUse and SessionStart are command hooks: the lease gate fails closed when the server is unreachable, and Claude Code does not support HTTP hooks for SessionStart. The rest report over HTTP; hook URLs must be literal (the validator rejects ${user_config} in url), so the server address is fixed here and only the token comes from user config.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "npx -y @clane-ai/baton-cli gate pretool", "timeout": 15 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "npx -y @clane-ai/baton-cli hook session-start", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "http", "url": "https://yemmiowsudakdviqqlnt.supabase.co/functions/v1/baton/hooks/prompt",
            "headers": { "Authorization": "Bearer ${user_config.agentToken}" }, "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__plugin_baton-core_baton__.*",
        "hooks": [
          { "type": "http", "url": "https://yemmiowsudakdviqqlnt.supabase.co/functions/v1/baton/hooks/tool",
            "headers": { "Authorization": "Bearer ${user_config.agentToken}" }, "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "http", "url": "https://yemmiowsudakdviqqlnt.supabase.co/functions/v1/baton/hooks/tool-failure",
            "headers": { "Authorization": "Bearer ${user_config.agentToken}" }, "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "http", "url": "https://yemmiowsudakdviqqlnt.supabase.co/functions/v1/baton/hooks/turn-end",
            "headers": { "Authorization": "Bearer ${user_config.agentToken}" }, "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "http", "url": "https://yemmiowsudakdviqqlnt.supabase.co/functions/v1/baton/hooks/session-end",
            "headers": { "Authorization": "Bearer ${user_config.agentToken}" }, "timeout": 10 }
        ]
      }
    ]
  }
}
